# Build output and IDE noise
target/
*/target/
.idea/
*.iml
.git/

# JWT signing keys must never be baked into an image - they are mounted at run time
# (or minted by the entrypoint for local runs). See scripts/docker-entrypoint.sh.
**/src/main/resources/certs/*.pem

# Runtime data, not build input
storage/
harmonia-app/storage/

docker-compose.yml
HELP.md
