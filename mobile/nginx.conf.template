server {
    listen 80;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${API_URL}/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Forwarded-Proto https;
        # Same-origin for the browser; forwarding Origin would trip the backend's dev-only CORS list.
        proxy_set_header Origin "";
        # Backend scopes the refresh cookie to /auth; the browser sees it under /api/auth.
        proxy_cookie_path /auth /api/auth;
        # Practice video goes up to 150 MB.
        client_max_body_size 151m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /manifest.json {
        add_header Cache-Control "no-cache";
    }

    location /_expo/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Static export writes one .html per route; dynamic routes ([id]) fall back to the shell and the client router resolves them.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri.html /index.html;
    }
}
