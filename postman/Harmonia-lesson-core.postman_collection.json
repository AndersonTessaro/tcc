  "item": [
    {
      "name": "00 - Preparação",
      "item": [
        {
          "name": "01 - Login administrador e iniciar execução",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString();",
                  "const date = new Date();",
                  "let days = (8 - date.getDay()) % 7;",
                  "if (days === 0) days = 7;",
                  "date.setDate(date.getDate() + days);",
                  "const pad = value => String(value).padStart(2, '0');",
                  "const testDate = `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;",
                  "pm.collectionVariables.set('suffix', suffix);",
                  "pm.collectionVariables.set('testDate', testDate);",
                  "['adminToken','teacherToken','studentToken','instrumentId','teacherId','studentId','enrollmentId','lessonId','scheduleId','makeupLessonId','lifecycleOriginalId','lifecycleMakeupId'].forEach(key => pm.collectionVariables.unset(key));",
                  "console.log(`Execução ${suffix}; data de teste ${testDate}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login do administrador: HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
                  "pm.expect(json.username).to.eql('admin');",
                  "pm.collectionVariables.set('adminToken', json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"login\": \"admin\",\n  \"password\": \"Admin@123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/login",
            "description": "Inicia uma execução limpa e salva adminToken."
          }
        },
        {
          "name": "02 - Confirmar administrador autenticado",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('administrador autenticado', () => pm.response.to.have.status(200));",
            "pm.expect(pm.response.json().username).to.eql('admin');"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/auth/me"
